if {game_state} == 3.0:
	if {crow_educated} == 0.0:
		Crow: be careful with the seelie
		Crow: gimme stuff
		set {crow_educated} = 1.0
	elif {crow_educated} == 1.0:
		if {all_things_gathered} == 0.0:
			Crow: not everything here
		elif {all_things_gathered} == 1.0:
			Crow: all here, have these berries
			set {game_state} = 4.0
			[signal arg="give berries"]
elif {game_state} >= 4.0 and {game_state} < 6.0:
	Crow: we're even now
elif {game_state} == 6.0:
	Crow: you can borrow MY knife
	[signal arg="give knife"]
elif {game_state} >= 7.0 and {game_state} < 8.0:
	if {crow_invited} == 0.0:
		Crow: I'll have my knife back now
		[signal arg="take knife"]
		set {crow_invited} = 1.0
	elif {crow_invited} == 1.0:
		Crow: thanks for the invite
elif {game_state} == 8.0:
	Crow: You still owe me one